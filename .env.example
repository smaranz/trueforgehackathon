# Probe and Fieldnotes bind to 127.0.0.1 only.
PORT=4310
DEMO_PORT=4311
RUN_DEADLINE_MS=600000

# Start npm run trueforge, then configure a real model provider in its Settings → Models.
# The model must match a configured FQN returned by the official SDK's models.list().
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_MODEL=openai/gpt-5-6-sol

# Full audits use fixed openai/gpt-5-6-sol, independent of legacy demo model selection.
# Optional: set to the target project's EXACT public HTTPS auth origin, with no path.
# This public URL is not an API secret. Leave unset to use the configured project default.
# AUDIT_AUTH_ORIGIN=https://your-project-ref.supabase.co

# Provider credentials belong in TrueForge Settings, never in VITE_ variables or actor prompts.
# No sandbox is attached to testing actors. Code verification runs locally under Playwright.
# RUN_DEADLINE_MS above applies to the original demo. Full-audit ceilings come from its request.
# Gmail mailbox/app-password configuration belongs in the encrypted backend vault;
# use scripts/configure-audit-mailbox.ts with a private input file, never model prompts.

# Local diagnostics dashboard (/#dashboard). Loopback HTTP targets only.
PROBE_TARGET_URL=http://localhost:3000/signup
# Exact origins, comma-separated. Defaults to the target origin and the Fieldnotes demo.
# PROBE_TARGET_ORIGINS=http://localhost:3000,http://127.0.0.1:4311

# Optional: connect the Git repository of the app being tested, not Probe's repository.
# Keep it clean (commit/stash your changes) before generating a proposal or building a fix.
# PROBE_SOURCE_ROOT=/absolute/path/to/your/app
# Verification commands are JSON argument arrays, run without a shell in an isolated worktree.
# Defaults: npm run build if present, and npm test if present in the target package.json.
# PROBE_BUILD_COMMAND=["npm","run","build"]
# PROBE_TEST_COMMAND=["npm","test"]
